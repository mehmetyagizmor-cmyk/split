# Production'da hosting platformu (Render vb.) bunu genelde otomatik ayarlar,
# ama emin olmak için elle de kontrol et — cookie güvenlik ayarları
# (secure/sameSite) bu değere göre değişiyor (bkz. auth.controller.ts).
NODE_ENV=development

PORT=4000

# Staff/admin login JWT'lerini imzalamak için kullanılır — asla paylaşma/commit etme.
# Üretmek için: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="degistir-bu-degeri-rastgele-uzun-bir-string-ile"

# Frontend'in çalıştığı origin — CORS'ta credential'lı (cookie'li) istekler için
# gerekli. Production'da gerçek frontend domain'in olmalı (örn. https://split.vercel.app),
# sonunda "/" OLMADAN.
FRONTEND_URL="http://localhost:5173"

# Neon Postgres — pooled bağlantı (uygulama runtime'ı için)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Neon Postgres — direct bağlantı (sadece migration'lar için)
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
